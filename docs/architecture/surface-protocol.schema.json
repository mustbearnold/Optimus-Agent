{
  "schema_version": 1,
  "protocol_version": 1,
  "framing": {
    "carriers": [
      "stdio",
      "ws"
    ],
    "encoding": "json-rpc-2.0",
    "line_delimited": true,
    "max_frame_bytes": 1048576,
    "ws_path": "/ws",
    "ws_close_codes": {
      "4001": "ticket rejected, credential-class violation, or hello deadline exceeded",
      "4002": "unsupported protocol version",
      "4003": "framing violation (binary/non-UTF-8/oversized) or too many connections"
    },
    "connections_log_line": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z origin=(missing|null|[^ ]+)$"
  },
  "methods": {
    "hello": {
      "kind": "protocol",
      "params": {
        "type": "object",
        "required": [
          "protocol_version",
          "client_kind"
        ],
        "properties": {
          "protocol_version": {
            "const": 1
          },
          "client_kind": {
            "enum": [
              "renderer",
              "tui",
              "cli",
              "shell"
            ]
          },
          "ticket": {
            "type": "string"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "protocol_version",
          "capabilities"
        ],
        "properties": {
          "protocol_version": {
            "const": 1
          },
          "capabilities": {
            "type": "object",
            "required": [
              "streaming",
              "carriers"
            ],
            "properties": {
              "streaming": {
                "const": true
              },
              "carriers": {
                "type": "array",
                "items": {
                  "enum": [
                    "stdio",
                    "ws"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "event": {
      "kind": "server-origin",
      "params": {
        "type": "object",
        "required": [
          "stream_id",
          "event"
        ],
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "$ref": "#/events"
          }
        }
      }
    },
    "host.ready": {
      "kind": "server-origin",
      "params": {
        "type": "object",
        "required": [
          "protocol_version"
        ],
        "properties": {
          "protocol_version": {
            "const": 1
          }
        }
      }
    },
    "host.error": {
      "kind": "server-origin",
      "params": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "chat_start": {
      "kind": "trio",
      "params": {
        "type": "object",
        "required": [
          "stream_id",
          "request"
        ],
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 0
          },
          "request": {
            "$ref": "#/chat_request"
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "stream_id"
        ],
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "chat_cancel": {
      "kind": "trio",
      "params": {
        "type": "object",
        "required": [
          "stream_id"
        ],
        "properties": {
          "stream_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "requested"
        ],
        "properties": {
          "requested": {
            "type": "boolean"
          }
        }
      }
    },
    "chat_approval_resolve_start": {
