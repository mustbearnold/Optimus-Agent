#!/usr/bin/env bash
# Optimus local gate. Versioned in-repo; enable with:
#
#   git config core.hooksPath .githooks     (or: just setup-hooks)
#
# Push is the gate, not commit. Coding agents commit frequently mid-task, and a
# blocking pre-commit hook trains everyone to reach for --no-verify, which
# removes the gate entirely. Push is the real boundary — this repo is public.
#
# Run a narrower tier when iterating:
#   OPTIMUS_VERIFY_TIER=test git push
#
# Emergency bypass (leaves the branch unverified):
#   git push --no-verify

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
TIER="${OPTIMUS_VERIFY_TIER:-all}"

# Git exports repository-local variables such as GIT_DIR to hooks. Those
# variables are correct for Git's own push process but unsafe for a test suite:
# a fixture that runs `git init --bare` in a temporary directory will instead
# reinitialize the real linked-worktree Git directory. Capture the worktree
# root first, then clear every local Git variable before any gate starts.
GIT_LOCAL_ENV=()
while IFS= read -r name; do
  [ -n "$name" ] && GIT_LOCAL_ENV+=("$name")
done < <(git rev-parse --local-env-vars)
for name in "${GIT_LOCAL_ENV[@]}"; do
  unset "$name"
done

# Gates that could not run leave their names here. A local skip stays allowed —
# a fresh worktree has no apps/optimus-electron/node_modules, and blocking on
# that would only teach --no-verify — but the push stops being called `clean`
# when it was not (#98).
SKIP_REPORT="$(mktemp)"
trap 'rm -f "$SKIP_REPORT"' EXIT
export OPTIMUS_VERIFY_SKIP_REPORT="$SKIP_REPORT"

printf '\n[pre-push] scripts/verify.sh %s\n' "$TIER"

if ! bash "$ROOT/scripts/verify.sh" "$TIER"; then
  cat <<'EOF'

[pre-push] BLOCKED — gates above failed.

  fix and retry            just verify
  narrow the tier          OPTIMUS_VERIFY_TIER=test git push
  push anyway (unverified) git push --no-verify

EOF
  exit 1
fi

if [ -s "$SKIP_REPORT" ]; then
  python3 "$ROOT/scripts/verify_skip_report.py" "$SKIP_REPORT"
else
  printf '[pre-push] clean\n\n'
fi
