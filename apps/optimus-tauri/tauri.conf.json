{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimus Agent",
  "version": "0.1.0",
  "identifier": "agent.optimus.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../optimus-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../optimus-ui build",
    "frontendDist": "../optimus-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Optimus Agent",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#0a0a0c"
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
